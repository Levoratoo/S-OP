# Copie para /opt/sites_dev/snop/.env no servidor
APP_PORT=3042

MYSQL_ROOT_PASSWORD=snop_root_change_me
MYSQL_DATABASE=sop_system
MYSQL_USER=snop
MYSQL_PASSWORD=snop_change_me

JWT_SECRET=troque-este-jwt-em-producao

# Auth local (bypass) — útil enquanto OAuth externo não estiver no ar
DEV_AUTH_BYPASS=true
DEV_AUTH_OPEN_ID=local-dev-user
DEV_AUTH_NAME=Admin S&OP
DEV_AUTH_EMAIL=admin@printbag.local
DEV_AUTH_ROLE=admin
DEV_AUTH_NIVEL_ACESSO=3

VITE_APP_ID=snop-printbag
PREVISAO_PYTHON_TIMEOUT_MIN=35
PREVISAO_PYTHON_HEARTBEAT_SEC=15
