NODE_ENV=development
PORT=3012
HOST=0.0.0.0
ENABLE_MANUS_RUNTIME=false

# Local MySQL (Docker)
DATABASE_URL=mysql://root:root@127.0.0.1:3307/sop_system

# OAuth placeholders (not required when DEV_AUTH_BYPASS=true)
OAUTH_SERVER_URL=http://127.0.0.1:9999
VITE_OAUTH_PORTAL_URL=http://127.0.0.1:9999
VITE_APP_ID=local-sop-app
OWNER_OPEN_ID=local-dev-user
JWT_SECRET=local-dev-secret-change-me

# Local auth bypass
DEV_AUTH_BYPASS=true
DEV_AUTH_OPEN_ID=local-dev-user
DEV_AUTH_NAME=Pedro Local
DEV_AUTH_EMAIL=pedro.local@example.com
DEV_AUTH_ROLE=admin
DEV_AUTH_NIVEL_ACESSO=3
PREVISAO_PYTHON_CMD=C:\path\to\sop-system\.venv-previsao\Scripts\python.exe
PREVISAO_PYTHON_TIMEOUT_MIN=35
PREVISAO_PYTHON_HEARTBEAT_SEC=15

# Faturamento via SQL Server (MetricsPROD)
ERP_MSSQL_SERVER=VMDB2
ERP_MSSQL_INSTANCE=VMDB2
ERP_MSSQL_PORT=49257
ERP_MSSQL_DATABASE=MetricsPROD
ERP_MSSQL_USER=mitraconnect
ERP_MSSQL_PASSWORD=
ERP_MSSQL_ENCRYPT=false
ERP_MSSQL_TRUST_CERT=true
ERP_FATURAMENTO_SOURCE=dbo.Usr_VIEW_MITRA_FAT_02
ERP_FATURAMENTO_DESDE=2020-01-01
ERP_CARTEIRA_SOURCE=dbo.View_Usr_PedidoVenda_SEOP1

# Optional Forge integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
